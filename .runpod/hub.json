{
    "title": "Image Processing Worker",
    "description": "GPU-accelerated image processing: background removal (rembg), upscaling, and more. Multi-tool architecture for easy extension.",
    "type": "serverless",
    "category": "image",
    "iconUrl": "https://raw.githubusercontent.com/danielgatis/rembg/main/examples/car-1.out.png",
    "config": {
        "runsOn": "GPU",
        "containerDiskInGb": 20,
        "presets": [
            {
                "name": "Default",
                "default": true,
                "gpuIds": "AMPERE_24,ADA_24",
                "workerConfig": {
                    "minWorkers": 0,
                    "maxWorkers": 3,
                    "idleTimeout": 5,
                    "scalerType": "QUEUE_DELAY",
                    "scalerValue": 4
                }
            },
            {
                "name": "Always Warm",
                "default": false,
                "gpuIds": "AMPERE_24,ADA_24",
                "workerConfig": {
                    "minWorkers": 1,
                    "maxWorkers": 3,
                    "idleTimeout": 60,
                    "scalerType": "QUEUE_DELAY",
                    "scalerValue": 4
                }
            }
        ]
    }
}